# HpcConnect configuration example — fallback when no `.env` is present.
# Copy to `.env` and fill in your values (the Livebook setup overlay can
# configure all of these interactively too).

HPC_CONNECT_CLUSTER=alex              # default cluster (or use SSH_ALIAS)
HPC_CONNECT_SSH_ALIAS=alex            # SSH alias / hostname to connect to
HPC_CONNECT_USERNAME=your_username
HPC_CONNECT_IDENTITY_FILE=~/.ssh/id_hpc
HPC_CONNECT_PROXY_JUMP=csnhr.nhr.fau.de
HPC_CONNECT_VAULT_DIR=$HPCVAULT/.cache/hpc_connect
HPC_CONNECT_WORK_DIR=$HOME/.cache/hpc_connect
HPC_CONNECT_PORT_RANGE=8000:8999

# SSH robustness (keep ON to avoid gateway throttling)
HPC_CONNECT_STEADY_CONNECTION=true
HPC_CONNECT_STEADY_TIMEOUT_SECONDS=30
HPC_CONNECT_RETRY_FOREVER=true

# HuggingFace Hub API token — required for gated/private model downloads.
# HUGGINGFACE_HUB_TOKEN=hf_your_token_here

